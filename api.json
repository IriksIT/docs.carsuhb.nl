        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" },
          {
            "name": "event",
            "in": "path",
            "required": true,
            "description": "The numeric ID of the event.",
            "schema": {
              "type": "integer",
              "example": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event detail with attendees.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": { "$ref": "#/components/schemas/EventDetail" }
                  }
                },
