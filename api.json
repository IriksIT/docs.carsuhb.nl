    "/crews/{crew}/stats": {
      "get": {
        "summary": "Get crew statistics",
        "description": "Returns general crew information alongside key statistics: member count, active car count, representative count, and event counts.",
        "operationId": "getCrewStats",
        "tags": ["Stats"],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" }
        ],
        "responses": {
          "200": {
            "description": "Crew info and statistics.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["crew", "stats"],
                      "properties": {
                        "crew": { "$ref": "#/components/schemas/CrewInfo" },
                        "stats": { "$ref": "#/components/schemas/CrewStats" }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "crew": {
                      "id": 1,
                      "name": "Dutch Performance Club",
                      "slug": "dutch-performance-club",
                      "description": "A community for performance car enthusiasts in the Netherlands.",
                      "plan": "pro",
                      "is_public": true,
                      "avatar_url": "https://carshub.nl/storage/crews/dpc-avatar.jpg",
                      "banner_url": "https://carshub.nl/storage/crews/dpc-banner.jpg",
                      "created_at": "2026-01-01T00:00:00.000000Z"
                    },
                    "stats": {
                      "members": 87,
                      "cars": 112,
                      "representatives": 14,
                      "past_events": 9,
                      "upcoming_events": 2
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/crews/{crew}/pages": {
      "get": {
        "summary": "List website pages",
        "description": "Returns configuration for all six website pages: `home`, `about`, `crew_list`, `events`, `event_detail`, and `contact`. Pages that have not been configured by the crew are returned with default values (`is_enabled: false`, empty settings).",
        "operationId": "getCrewPages",
        "tags": ["Pages"],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" }
        ],
        "responses": {
          "200": {
            "description": "All six page configurations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "minItems": 6,
                      "maxItems": 6,
                      "items": { "$ref": "#/components/schemas/Page" }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "key": "home",
                      "is_enabled": true,
                      "title": "Welcome to Dutch Performance Club",
                      "top_text": "We are a passionate group of car enthusiasts based in the Netherlands.",
                      "settings": {
                        "show_featured_builds": true,
                        "show_latest_events": true,
                        "cta_text": "Join Us Today"
                      }
                    },
                    {
                      "key": "about",
                      "is_enabled": true,
                      "title": null,
                      "top_text": null,
                      "settings": {}
                    },
                    {
                      "key": "crew_list",
                      "is_enabled": true,
                      "title": null,
                      "top_text": null,
                      "settings": {}
                    },
                    {
                      "key": "events",
                      "is_enabled": true,
                      "title": null,
                      "top_text": null,
                      "settings": {}
                    },
                    {
                      "key": "event_detail",
                      "is_enabled": false,
                      "title": null,
                      "top_text": null,
                      "settings": {}
                    },
                    {
                      "key": "contact",
                      "is_enabled": true,
                      "title": "Get in Touch",
                      "top_text": null,
                      "settings": {
                        "contact_form_enabled": true,
                        "contact_form_email": "crew@example.com"
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/crews/{crew}/pages/{pageKey}": {
      "get": {
        "summary": "Get a single website page",
        "description": "Returns configuration for one website page by its key. Returns default values if the page has not been configured yet. Returns 404 for unrecognised page keys.",
        "operationId": "getCrewPage",
        "tags": ["Pages"],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" },
          {
            "name": "pageKey",
            "in": "path",
            "required": true,
            "description": "The page key.",
            "schema": {
              "type": "string",
              "enum": ["home", "about", "crew_list", "events", "event_detail", "contact"],
              "example": "home"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Page" }
                  }
                },
                "example": {
                  "data": {
                    "key": "home",
                    "is_enabled": true,
                    "title": "Welcome to Dutch Performance Club",
                    "top_text": "We are a passionate group of car enthusiasts based in the Netherlands.",
                    "settings": {
                      "show_featured_builds": true,
                      "show_latest_events": true,
                      "cta_text": "Join Us Today"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/crews/{crew}/import/events": {
      "post": {
        "summary": "Create an event",
        "description": "Creates a new event on a system-managed crew. Requires the crew's `EventImportKey` bearer token. The event is attributed to the CarsHub system account.",
        "operationId": "importCrewEvent",
        "tags": ["Event Import"],
        "security": [{ "EventImportKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EventImportRequest" },
              "example": {
                "title": "Silvia Cup Round 1",
                "description": "First round of the Nissan Silvia one-make series at Zandvoort.",
                "location": "Circuit Zandvoort",
                "address": "Burgemeester van Alphenstraat 108, Zandvoort",
                "starts_at": "2026-08-15T09:00:00Z",
                "ends_at": "2026-08-15T17:00:00Z",
                "members_only": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Event" }
                  }
                },
                "example": {
                  "data": {
                    "id": 12,
                    "title": "Silvia Cup Round 1",
                    "description": "First round of the Nissan Silvia one-make series at Zandvoort.",
                    "location": "Circuit Zandvoort",
                    "address": "Burgemeester van Alphenstraat 108, Zandvoort",
                    "members_only": false,
                    "starts_at": "2026-08-15T09:00:00.000000Z",
                    "ends_at": "2026-08-15T17:00:00.000000Z",
                    "avatar_url": null,
                    "banner_url": null
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedImport" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/crews/{crew}/import/events/{event}": {
      "put": {
        "summary": "Update an event",
        "description": "Replaces all fields of an existing event on a system-managed crew. Requires the crew's `EventImportKey` bearer token. All fields except `title` and `starts_at` are optional and will be set to `null` if omitted.",
        "operationId": "updateImportedCrewEvent",
        "tags": ["Event Import"],
        "security": [{ "EventImportKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" },
          {
            "name": "event",
            "in": "path",
            "required": true,
            "description": "The numeric ID of the event.",
            "schema": {
              "type": "integer",
              "example": 12
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EventImportRequest" },
              "example": {
                "title": "Silvia Cup Round 1 — Updated",
                "description": "Updated details for round 1.",
                "location": "Circuit Zandvoort",
                "address": "Burgemeester van Alphenstraat 108, Zandvoort",
                "starts_at": "2026-08-15T09:00:00Z",
                "ends_at": "2026-08-15T18:00:00Z",
                "members_only": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Event" }
                  }
                },
                "example": {
                  "data": {
                    "id": 12,
                    "title": "Silvia Cup Round 1 — Updated",
                    "description": "Updated details for round 1.",
                    "location": "Circuit Zandvoort",
                    "address": "Burgemeester van Alphenstraat 108, Zandvoort",
                    "members_only": false,
                    "starts_at": "2026-08-15T09:00:00.000000Z",
                    "ends_at": "2026-08-15T18:00:00.000000Z",
                    "avatar_url": null,
                    "banner_url": null
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedImport" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "summary": "Delete an event",
        "description": "Permanently deletes an event from a system-managed crew. Requires the crew's `EventImportKey` bearer token.",
        "operationId": "deleteImportedCrewEvent",
        "tags": ["Event Import"],
        "security": [{ "EventImportKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" },
          {
            "name": "event",
            "in": "path",
            "required": true,
            "description": "The numeric ID of the event.",
            "schema": {
              "type": "integer",
              "example": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Event deleted."
                    }
                  }
                },
                "example": { "message": "Event deleted." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedImport" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CrewApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The crew's website API key. Generated when the Website Sync module is enabled. Format: `chk_<48 random characters>`."
      },
      "EventImportKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The crew's event import key. Generated when the crew is created via the `crews:create-system` command. Format: `eik_<48 random characters>`. Only system-managed crews have this key."
      }
    },
    "parameters": {
      "CrewSlug": {
        "name": "crew",
        "in": "path",
        "required": true,
        "description": "The slug of the crew.",
        "schema": {
          "type": "string",
          "example": "dutch-performance-club"
        }
      }
    },
    "responses": {
      "HttpsRequired": {
        "description": "The request was made over plain HTTP. HTTPS is required for all endpoints.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorMessage" },
            "example": { "message": "HTTPS is required." }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid Website Sync API key.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorMessage" },
            "example": { "message": "Invalid or missing API key." }
          }
        }
      },
      "UnauthorizedImport": {
        "description": "Missing or invalid event import key.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorMessage" },
            "example": { "message": "Invalid or missing event import key." }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden. Returned when the request is made over plain HTTP (`HTTPS is required.`) or when the Website Sync module is not enabled for this crew.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorMessage" },
            "examples": {
              "https_required": {
                "summary": "Plain HTTP request rejected",
                "value": { "message": "HTTPS is required." }
              },
              "module_disabled": {
                "summary": "Website Sync module not enabled",
                "value": { "message": "Website Sync module is not enabled for this crew." }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource was not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorMessage" }
          }
        }
      },
      "ValidationError": {
        "description": "The request body failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["message", "errors"],
              "properties": {
                "message": {
                  "type": "string",
                  "example": "The title field is required."
                },
                "errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "example": {
                    "title": ["The title field is required."],
                    "starts_at": ["The starts at field is required."]
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorMessage": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid or missing API key."
          }
        }
      },
      "Member": {
        "type": "object",
        "required": ["id", "name", "username", "avatar_url", "role", "staff_title", "joined_at"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 42
          },
          "name": {
            "type": "string",
            "example": "Jan de Vries"
          },
          "username": {
            "type": "string",
            "example": "jandevries"
          },
          "avatar_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/avatars/jan.jpg"
          },
          "role": {
            "type": ["string", "null"],
            "enum": ["owner", "mod", "member", null],
            "example": "mod"
          },
          "staff_title": {
            "type": ["string", "null"],
            "example": "Event Organiser"
          },
          "joined_at": {
            "type": ["string", "null"],
            "description": "ISO 8601 date-time or date string of when the member joined.",
            "example": "2026-01-15T09:00:00.000000Z"
          }
        }
      },
      "CarOwner": {
        "type": "object",
        "required": ["id", "name", "username"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 42
          },
          "name": {
            "type": "string",
            "example": "Jan de Vries"
          },
          "username": {
            "type": "string",
            "example": "jandevries"
          }
        }
      },
      "Car": {
        "type": "object",
        "required": [
          "id", "slug", "make", "model", "year", "color", "description",
          "edition", "horsepower", "engine_size", "transmission",
          "drive_type", "body_style", "avatar_url", "owner"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 7
          },
          "slug": {
            "type": "string",
            "example": "2019-volkswagen-golf"
          },
          "make": {
            "type": "string",
            "example": "Volkswagen"
          },
          "model": {
            "type": "string",
            "example": "Golf"
          },
          "year": {
            "type": "integer",
            "example": 2019
          },
          "color": {
            "type": ["string", "null"],
            "example": "Deep Black Pearl"
          },
          "description": {
            "type": ["string", "null"],
            "example": "Stage 2 build with custom intercooler."
          },
          "edition": {
            "type": ["string", "null"],
            "example": "GTI Performance"
          },
          "horsepower": {
            "type": ["integer", "null"],
            "example": 245
          },
          "engine_size": {
            "type": ["string", "null"],
            "example": "2.0 TSI"
          },
          "transmission": {
            "type": ["string", "null"],
            "example": "DSG"
          },
          "drive_type": {
            "type": ["string", "null"],
            "example": "FWD"
          },
          "body_style": {
            "type": ["string", "null"],
            "example": "Hatchback"
          },
          "avatar_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/cars/golf.jpg"
          },
          "owner": {
            "$ref": "#/components/schemas/CarOwner"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id", "title", "description", "location", "address",
          "members_only", "starts_at", "ends_at", "avatar_url", "banner_url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "title": {
            "type": "string",
            "example": "Summer Meet 2026"
          },
          "description": {
            "type": ["string", "null"],
            "example": "Annual summer gathering at Zandvoort."
          },
          "location": {
            "type": ["string", "null"],
            "example": "Zandvoort Circuit"
          },
          "address": {
            "type": ["string", "null"],
            "example": "Circuit Park Zandvoort, Burgemeester van Alphenstraat 108"
          },
          "members_only": {
            "type": "boolean",
            "example": false
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T10:00:00.000000Z"
          },
          "ends_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "example": "2026-07-12T18:00:00.000000Z"
          },
          "avatar_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/events/summer-meet.jpg"
          },
          "banner_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/events/summer-meet-banner.jpg"
          }
        }
      },
      "Attendee": {
        "type": "object",
        "required": ["id", "name", "username", "avatar_url", "status"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 42
          },
          "name": {
            "type": "string",
            "example": "Jan de Vries"
          },
          "username": {
            "type": "string",
            "example": "jandevries"
          },
          "avatar_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/avatars/jan.jpg"
          },
          "status": {
            "type": "string",
            "enum": ["attending", "maybe"],
            "example": "attending"
          }
        }
      },
      "EventDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Event" },
          {
            "type": "object",
            "required": ["attendees_count", "attendees"],
            "properties": {
              "attendees_count": {
                "type": "integer",
                "description": "Number of attendees with status `attending` or `maybe`.",
                "example": 24
              },
              "attendees": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Attendee" }
              }
            }
          }
        ]
      },
      "CrewInfo": {
        "type": "object",
        "required": ["id", "name", "slug", "description", "plan", "is_public", "avatar_url", "banner_url", "created_at"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Dutch Performance Club"
          },
          "slug": {
            "type": "string",
            "example": "dutch-performance-club"
          },
          "description": {
            "type": ["string", "null"],
            "example": "A community for performance car enthusiasts in the Netherlands."
          },
          "plan": {
            "type": "string",
            "enum": ["free", "pro"],
            "example": "pro"
          },
          "is_public": {
            "type": "boolean",
            "example": true
          },
          "avatar_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/crews/dpc-avatar.jpg"
          },
          "banner_url": {
            "type": ["string", "null"],
            "format": "uri",
            "example": "https://carshub.nl/storage/crews/dpc-banner.jpg"
          },
          "created_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000000Z"
          }
        }
      },
      "CrewStats": {
        "type": "object",
        "required": ["members", "cars", "representatives", "past_events", "upcoming_events"],
        "properties": {
          "members": {
            "type": "integer",
            "description": "Total number of crew members.",
            "example": 87
          },
          "cars": {
            "type": "integer",
            "description": "Total number of active cars owned by crew members.",
            "example": 112
          },
          "representatives": {
            "type": "integer",
            "description": "Number of users who have this crew set as their featured crew.",
            "example": 14
          },
          "past_events": {
            "type": "integer",
            "description": "Number of events that have already taken place.",
            "example": 9
          },
          "upcoming_events": {
            "type": "integer",
            "description": "Number of events scheduled in the future.",
            "example": 2
          }
        }
      },
      "PageSettings": {
        "type": "object",
        "description": "Free-form key/value settings configured per page. Available keys depend on the page type.",
        "additionalProperties": true,
        "properties": {
          "show_featured_builds": {
            "type": "boolean",
            "description": "Home page — whether to show a featured builds block."
          },
          "show_latest_events": {
            "type": "boolean",
            "description": "Home page — whether to show the latest events block."
          },
          "cta_text": {
            "type": "string",
            "description": "Home page — call-to-action button label.",
            "example": "Join Us Today"
          },
          "contact_form_enabled": {
            "type": "boolean",
            "description": "Contact page — whether the contact form is active."
          },
          "contact_form_email": {
            "type": "string",
            "format": "email",
            "description": "Contact page — email address that receives contact form submissions.",
            "example": "crew@example.com"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": ["key", "is_enabled", "title", "top_text", "settings"],
        "properties": {
          "key": {
            "type": "string",
            "enum": ["home", "about", "crew_list", "events", "event_detail", "contact"],
            "example": "home"
          },
          "is_enabled": {
            "type": "boolean",
            "description": "Whether this page is enabled on the external website.",
            "example": true
          },
          "title": {
            "type": ["string", "null"],
            "description": "Optional custom page title set by the crew.",
            "example": "Welcome to Dutch Performance Club"
          },
          "top_text": {
            "type": ["string", "null"],
            "description": "Optional introductory text shown at the top of the page.",
            "example": "We are a passionate group of car enthusiasts based in the Netherlands."
          },
          "settings": {
            "$ref": "#/components/schemas/PageSettings"
          }
        }
      },
      "EventImportRequest": {
        "type": "object",
        "required": ["title", "starts_at"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Silvia Cup Round 1"
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 1000,
            "example": "First round of the Nissan Silvia one-make series."
          },
          "location": {
            "type": ["string", "null"],
            "maxLength": 200,
            "example": "Circuit Zandvoort"
          },
          "address": {
            "type": ["string", "null"],
            "maxLength": 500,
            "example": "Burgemeester van Alphenstraat 108, Zandvoort"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-15T09:00:00Z"
          },
          "ends_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Must be after `starts_at` and within 7 days of it.",
            "example": "2026-08-15T17:00:00Z"
          },
          "members_only": {
            "type": "boolean",
            "default": false,
            "example": false
          }
        }
      }
    }
  }
}
