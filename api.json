{
  "openapi": "3.1.0",
  "info": {
    "title": "CarsHub Crew API",
    "version": "1.1.0",
    "description": "API for syncing crew data to an external website and importing events into system-managed crews. **HTTPS is mandatory** — plain HTTP requests are rejected with 403.\n\n## Authentication\n\nTwo separate bearer-token schemes are used depending on the endpoint group:\n\n- **Website Sync API** (`CrewApiKey`) — read-only endpoints for syncing crew data to an external website. Key obtained from the Website Sync module settings in the crew dashboard. Format: `chk_<48 random characters>`.\n- **Event Import API** (`EventImportKey`) — write endpoints for importing events into a system-managed crew. Key generated when the crew is created via the `crews:create-system` command. Format: `eik_<48 random characters>`."
  },
  "servers": [
    {
      "url": "https://carshub.nl/api",
      "description": "CarsHub production API (HTTPS only)"
    }
  ],
  "security": [
    {
      "CrewApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Members",
      "description": "Crew member roster."
    },
    {
      "name": "Cars",
      "description": "Cars owned by crew members."
    },
    {
      "name": "Events",
      "description": "Past and upcoming crew events."
    },
    {
      "name": "Stats",
      "description": "Crew overview statistics."
    },
    {
      "name": "Pages",
      "description": "Website page configuration managed via the Website Sync module."
    },
    {
      "name": "Event Import",
      "description": "Write endpoints for importing events into a system-managed crew. Requires the `EventImportKey` bearer token (`eik_*`) generated when the crew is created."
    }
  ],
  "paths": {
    "/crews/{crew}/members": {
      "get": {
        "summary": "List crew members",
        "description": "Returns all members of the crew ordered by join date (oldest first).",
        "operationId": "getCrewMembers",
        "tags": ["Members"],
        "parameters": [
          { "$ref": "#/components/parameters/CrewSlug" }
        ],
        "responses": {
          "200": {
            "description": "A list of crew members.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Member" }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "name": "Matthijs Iriks",
                      "username": "matthijsiriks",
                      "avatar_url": "https://carshub.nl/storage/avatars/matthijs.jpg",
                      "role": "owner",
                      "staff_title": null,
                      "joined_at": "2026-01-01T00:00:00.000000Z"
                    },
                    {
                      "id": 42,
                      "name": "Jan de Vries",
                      "username": "jandevries",
                      "avatar_url": "https://carshub.nl/storage/avatars/jan.jpg",
                      "role": "mod",
                      "staff_title": "Event Organiser",
                      "joined_at": "2026-01-15T09:00:00.000000Z"
                    },
                    {
                      "id": 57,
                      "name": "Sven Bakker",
                      "username": "svenbakker",
                      "avatar_url": null,
                      "role": "member",
                      "staff_title": null,
                      "joined_at": "2026-02-20T14:30:00.000000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
